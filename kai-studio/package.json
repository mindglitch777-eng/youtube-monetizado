{
  "name": "kai-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Kai Shorts studio: Remotion project + image organizer + audio tools",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "check": "tsc --noEmit",
    "test": "tsx tools/test-timeline.ts",
    "render:en": "remotion render src/index.ts Kai out/kai-p1-en.mp4 --props=\"{\\\"slug\\\":\\\"love-bombing\\\",\\\"lang\\\":\\\"en\\\"}\"",
    "render:es": "remotion render src/index.ts Kai out/kai-p1-es.mp4 --props=\"{\\\"slug\\\":\\\"love-bombing\\\",\\\"lang\\\":\\\"es\\\"}\"",
    "preview:en": "remotion render src/index.ts Kai out/preview-en.mp4 --scale=0.35 --crf=34 --props=\"{\\\"slug\\\":\\\"love-bombing\\\",\\\"lang\\\":\\\"en\\\"}\"",
    "preview:es": "remotion render src/index.ts Kai out/preview-es.mp4 --scale=0.35 --crf=34 --props=\"{\\\"slug\\\":\\\"love-bombing\\\",\\\"lang\\\":\\\"es\\\"}\""
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/fonts": "^4.0.531",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
